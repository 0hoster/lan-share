# lan-share 配置示例
#
# 用法：复制成 .env 放在启动目录（或 --env-file 指定路径）即可生效。
# 优先级：命令行参数 > 环境变量 / .env > 内置默认值。
# 已存在的环境变量不会被 .env 覆盖。

# ---- 服务 ----
LAN_SHARE_HOST=0.0.0.0
LAN_SHARE_PORT=8080
LAN_SHARE_DATA_DIR=lan-share-data
# 分片大小（MiB，1~64）
LAN_SHARE_CHUNK_MIB=8
# 访问令牌：留空自动生成随机令牌，注释掉表示不启用
# LAN_SHARE_TOKEN=mySecret

# ---- 直播 ----
# 同时进行的直播上限，0 表示不限制
LAN_SHARE_LIVE_MAX_ROOMS=8
# 单场直播的观众上限，0 表示不限制
LAN_SHARE_LIVE_MAX_VIEWERS=32
# 主播多久没有数据就自动结束直播（秒）
LAN_SHARE_LIVE_IDLE_SECS=90

# ---- 终端与日志 ----
# 是否显示底部实时统计面板（非终端环境会自动关闭）
LAN_SHARE_DASHBOARD=1
# 是否打印启动横幅
LAN_SHARE_BANNER=1
# 日志级别，等价于 RUST_LOG
LAN_SHARE_LOG=lan_share=info,warn
